# ---------------------------------------------------------------------------
# Formly - environment variables
#
# Backend values live in backend/.env, frontend values in frontend/.env.local.
# This file documents both. Never commit real secrets.
# ---------------------------------------------------------------------------

# === Backend (backend/.env) ================================================

# Hugging Face access token (free: https://huggingface.co/settings/tokens).
# Optional but strongly recommended. Anonymous calls to the ZeroGPU Space share
# a tiny per-IP quota and fail with "exceeded your ZeroGPU quota" under any real
# use. A free read token raises that quota substantially.
# Backend only -- never exposed to the browser.
HF_TOKEN=

# Generation provider id: shap-e (default) or trellis
PROVIDER=shap-e

# Hugging Face Space backing the provider.
HF_SPACE=hysts/Shap-E

# Shap-E sampling. 64 steps is the quality/latency knee.
INFERENCE_STEPS=64
GUIDANCE_SCALE=15.0

# Reliability. ZeroGPU Spaces sleep and return 502 while waking, so the
# connect+predict cycle is retried.
PROVIDER_MAX_ATTEMPTS=6
PROVIDER_BACKOFF_SECONDS=4.0
PROVIDER_BACKOFF_CAP_SECONDS=10.0
PROVIDER_TIMEOUT_SECONDS=300

# Generated assets are held in memory/temp disk for this long, then dropped.
ASSET_TTL_SECONDS=3600
MAX_STORED_ASSETS=64

# Exact allowed origins, comma separated. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Basic abuse guard, per client IP.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=300


# === Frontend (frontend/.env.local) ========================================

# Base URL of the backend. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Provider: trellis (EXPERIMENTAL / UNVERIFIED, opt-in) ------------------
# No live generation has ever completed through this provider, so no claim is
# made about its output quality relative to Shap-E. Backend-only: there is no
# user-facing model selection.
#
# One generation drives three pipeline stages, two of which consume GPU quota
# (generate_txt2img and generate_3d, each @spaces.GPU(size="xlarge",
# duration=120)); preprocess_image is not GPU-decorated. That is ~240
# GPU-seconds on a large tier vs Shap-E's single 60 s call, so a free ZeroGPU
# allowance is exhausted roughly 4x faster. Not the default -- see the
# Provider evaluation section of the README.
TRELLIS_SPACE=prithivMLmods/TRELLIS.2-Text-to-3D
TRELLIS_RESOLUTION=1024
TRELLIS_TEXTURE_SIZE=1024
TRELLIS_DECIMATION_TARGET=150000
TRELLIS_MAX_ATTEMPTS=2
TRELLIS_TIMEOUT_SECONDS=600
